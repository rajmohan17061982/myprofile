extends layout

block content
  section.error-page.wrap
    p.eyebrow RESUME / DOWNLOAD
    h1 Resume PDF not added yet.
    p.page-lead Add the verified CV as public/resume.pdf when it is ready to share. The placeholder link avoids publishing an unverified document.
    a.button.button-primary(href="/resume") View career overview <span aria-hidden="true">↗</span>
